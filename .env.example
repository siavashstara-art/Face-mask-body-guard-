# ===================================================================
# FaceCard Ecosystem & Automated API Key Configuration
# Configured for seamless zero-setup execution on mobile devices.
# All modules (Studio, FarshBazar, TalaYar, Ecosystem) run securely on-device.
# ===================================================================

# Automated Security Protocol & On-Device Encryption Engine
TAVANA_SECURITY_MODE=AES_256_LOCAL
TAVANA_ECOSYSTEM_ENV=PRODUCTION_STANDALONE
TAVANA_AUTO_SIGNATURE=APPROVED_OFFICIAL

# Optional Service Gateways (Automated fallback to on-device engine)
TAVANA_API_ENDPOINT=https://api.facecard.ir/v1
TAVANA_MERCHANT_ID=IR_TAJIR_48_BAZAR
